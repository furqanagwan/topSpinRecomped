<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <Identity Name="2KSports.TOPSPIN3"
            Publisher="CN=2K Sports"
            Version="1.0.0.0"/>

  <Resources>
    <Resource Language="en-US"/>
  </Resources>

  <ExecutableList>
    <Executable Name="Top Spin 3.exe"
                Id="Game"
                Alias="TopSpin3.exe"
                OverrideDisplayName="Top Spin 3"/>
  </ExecutableList>

  <ShellVisuals DefaultDisplayName="Top Spin 3"
                PublisherDisplayName="2K Sports"
                StoreLogo="StoreLogo.png"
                Square150x150Logo="Logo.png"
                Square44x44Logo="SmallLogo.png"
                SplashScreenImage="SplashScreen.png"
                Description="2K Sports tennis, first released on Xbox 360 in 2008. Native PC recompilation of the Xbox 360 version; runs from your own copy of the game."
                BackgroundColor="#000000"
                ForegroundText="light"/>

  <DesktopRegistration>
    <DependencyList>
      <KnownDependency Name="VC14"/>
    </DependencyList>
    <ProcessorArchitecture>x64</ProcessorArchitecture>
  </DesktopRegistration>
</Game>
